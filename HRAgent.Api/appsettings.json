{
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "your-tenant-id-here",
    "ClientId": "your-client-id-here",
    "Audience": "api://your-client-id-here"
  },
  "MongoDB": {
    "ConnectionString": "@Microsoft.KeyVault(SecretUri=https://{vault-name}.vault.azure.net/secrets/MongoDbConnectionString)",
    "DatabaseName": "hragent"
  },
  "BlobStorage": {
    "ConnectionString": "@Microsoft.KeyVault(SecretUri=https://{vault-name}.vault.azure.net/secrets/BlobStorageConnectionString)",
    "ContainerName": "audit-logs"
  },
  "Factorial": {
    "BaseUrl": "https://api.factorialhr.com",
    "ApiKey": "@Microsoft.KeyVault(SecretUri=https://{vault-name}.vault.azure.net/secrets/FactorialApiKey)",
    "ApiVersion": "2025-10-01"
  },
  "AllowedOrigins": [
    "http://localhost:5173",
    "https://localhost:5173"
  ],
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Identity": "Information",
      "MongoDB.Driver": "Information",
      "HRAgent.Api.Services.AuditLogger": "Debug"
    }
  },
  "AllowedHosts": "*"
}
