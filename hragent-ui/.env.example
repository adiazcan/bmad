# Azure AD Configuration (Frontend)
VITE_AZURE_AD_CLIENT_ID=your-frontend-client-id-here
VITE_AZURE_AD_TENANT_ID=your-tenant-id-here
VITE_AZURE_AD_REDIRECT_URI=http://localhost:5173
VITE_AZURE_AD_AUTHORITY=https://login.microsoftonline.com/your-tenant-id-here

# Backend API Configuration
VITE_API_URL=http://localhost:5000

# Backend API Scope (for token audience)
VITE_AZURE_AD_API_SCOPE=api://your-backend-client-id-here/access_as_user
